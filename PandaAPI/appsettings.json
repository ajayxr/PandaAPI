{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PandaAPI",
    "Audience": "PandaAPI"
  },
  "ExternalApis": {
    "CnpjAi": {
      "BaseUrl": "https://api.cnpj.ai/v2/"
    }
  },
  "Rate_Limit_Register": 5,
  "Rate_Limit_Register_Window_Seconds": 60,
  "Rate_Limit_Login": 5,
  "Rate_Limit_Login_Window_Seconds": 60,
  "Rate_Limit_Guest": 30,
  "Rate_Limit_Guest_Window_Seconds": 60,
  "Rate_Limit_Validate": 30,
  "Rate_Limit_Validate_Window_Seconds": 60,
  "Rate_Limit_Health_Live": 60,
  "Rate_Limit_Health_Live_Window_Seconds": 60,
  "Rate_Limit_Health_Ready": 12,
  "Rate_Limit_Health_Ready_Window_Seconds": 60
}
